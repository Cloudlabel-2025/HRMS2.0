# Production secrets: generate unique values in the deployment secret manager.
MONGODB_URI=
JWT_SECRET=
IDENTITY_FIELD_ENCRYPTION_KEY=
CRON_SECRET=
APP_URL=https://hrms.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_EMAIL=
ENABLE_SEED_ROUTE=false
# Optional additional local-only admin emails (comma separated).
# superadmin@hrms.com is always local-only; Kavin's dev-admin account is exempt.
LOCAL_ONLY_ADMIN_EMAILS=
# Set true only for a migration/maintenance window; redeploy after changing.
MAINTENANCE_MODE=false
